# Copy to agent/.env (git-ignored) and fill in. Loaded by loop.sh and compose.

# Claude authentication: ONE of the two.
#   Subscription: run `claude setup-token` on the host once and paste the token.
#   API billing:  an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# GitHub fine-grained token, repository access: camory/libris only.
# Permissions: Contents (read/write), Pull requests (read/write),
#              Issues (read/write, for the review:* labels), Metadata (read).
# NO Workflows permission: CI files are changed by humans.
GH_TOKEN=

# Commit identity used inside the sandbox.
GIT_AUTHOR_NAME=Tophe
GIT_AUTHOR_EMAIL=christophe@amory.fr

# Defaults for every role (safety net, tune as you learn).
MODEL=fable
EFFORT=high
MAX_TURNS=120
MAX_BUDGET_USD=15
AUTOCOMPACT=150000

# Optional per-role overrides: <ROLE>_MODEL, _EFFORT, _MAX_TURNS, _MAX_BUDGET_USD,
# _AUTOCOMPACT
# where ROLE is PLANNER_BACKLOG, PLANNER_BRIEF, IMPLEMENTER or REVIEWER.
# PLANNER_BRIEF_MAX_TURNS=40
# REVIEWER_MODEL=sonnet

# How often to check whether the PR was merged, in seconds.
PR_POLL_SECONDS=300

# Host uid/gid so files written in the sandbox stay yours.
AGENT_UID=1000
AGENT_GID=1000
